# Postgres connection strings (local docker, or injected by the Neon integration on Vercel).
# DATABASE_URL may be pooled; DATABASE_URL_UNPOOLED is the direct connection Prisma uses for migrations.
DATABASE_URL="postgresql://postgres:pg@localhost:5432/vocabtext"
DATABASE_URL_UNPOOLED="postgresql://postgres:pg@localhost:5432/vocabtext"

# OpenAI — sentence generation, grading, placement, word picking, Whisper voice-note transcription
OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
# OPENAI_TRANSCRIBE_MODEL="whisper-1"
# Optional: point at any OpenAI-compatible provider
# OPENAI_BASE_URL="https://api.openai.com/v1"

# Meta WhatsApp Cloud API (developers.facebook.com → your app → WhatsApp)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Token you choose; enter the same value in the Meta webhook config for /api/whatsapp/webhook
WHATSAPP_VERIFY_TOKEN=""
# App secret, used to validate X-Hub-Signature-256 on inbound webhooks (required in prod)
WHATSAPP_APP_SECRET=""
# Approved authentication template name for the signup code (required in prod;
# leave empty in dev to send the code as plain text, which works with Meta test numbers)
# WHATSAPP_VERIFY_TEMPLATE="vocabtext_verify"
# Approved UTILITY template for the daily quiz (one {{1}} body variable = the quiz text).
# Leave unset to send the quiz as free-form text (only deliverable inside the 24h window).
# See docs/going-live.md §4. Language must match the template's language code exactly.
# WHATSAPP_QUIZ_TEMPLATE=""
# WHATSAPP_QUIZ_TEMPLATE_LANG="en"

# Shared secret for the hourly cron endpoint (Vercel Cron sets this automatically)
CRON_SECRET=""
