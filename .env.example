# Database (SQLite for dev; swap provider for prod, e.g. Turso/Postgres)
DATABASE_URL="file:./dev.db"

# OpenAI — sentence generation, lenient answer grading, cadence optimization
OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
# Optional: point at any OpenAI-compatible provider
# OPENAI_BASE_URL="https://api.openai.com/v1"

# Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER="+1..."
# Public URL Twilio posts inbound SMS to (used for signature validation in prod)
TWILIO_WEBHOOK_URL="https://yourdomain.com/api/twilio/webhook"

# Shared secret for the hourly cron endpoint (Vercel Cron sets this automatically)
CRON_SECRET=""
